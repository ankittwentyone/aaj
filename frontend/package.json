    "typescript": "5.7.3",
    "vite": "8.0.4",
    "vitest": "3.1.3"
  },
  "bundlesize": [
    {
      "path": "dist/assets/vendor-*.js",
      "maxSize": "80 kB"
    },
    {
      "path": "dist/assets/map-*.js",
      "maxSize": "180 kB"
