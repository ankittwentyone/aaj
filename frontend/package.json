    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "16.2.0",
    "@testing-library/user-event": "^14.6.7",
    "@types/maplibre-gl": "1.14.0",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.3.4",
    "bundlesize": "0.18.1",
    "d3-array": "3.2.4",
    "d3-hierarchy": "3.1.2",
    "d3-scale": "4.0.2",
