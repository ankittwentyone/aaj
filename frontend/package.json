    "lightweight-charts": "5.0.8",
    "lucide-react": "0.469.0",
    "maplibre-gl": "5.5.0",
    "motion": "^12.23.12",
    "motion-dom": "^12.23.28",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-map-gl": "8.0.4",
    "react-markdown": "9.0.1",
    "react-router-dom": "7.1.5",
    "rehype-sanitize": "6.0.0",
